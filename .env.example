# "api" (default) reads real historical data from the FastAPI backend.
# "demo" serves bundled sample data with fabricated statistics.
# The app never falls back to demo data if the API fails.
VITE_DATA_SOURCE=api

# Base URL of the backend. "/api" uses the Vite dev proxy.
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api. Change it if the backend runs on another port.
VITE_PROXY_TARGET=http://localhost:8001
