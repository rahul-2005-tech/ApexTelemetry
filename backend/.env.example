# Copy to backend/.env (git-ignored). Everything here is optional.

# FastF1 cache location. Default: %LOCALAPPDATA%\ApexTelemetry\fastf1-cache (outside OneDrive).
# APEX_CACHE_DIR=C:\Users\you\AppData\Local\ApexTelemetry\fastf1-cache

# Season range served by the API.
# APEX_MIN_SEASON=2018
# APEX_MAX_SEASON=2026

# Extra CORS origins, comma-separated. Any http://localhost:<port> is already allowed.
# APEX_CORS_EXTRA_ORIGINS=

# OPTIONAL, telemetry endpoint only. Needs an F1TV Access/Pro/Premium subscription.
# Race results and schedules work without these. Never commit this file.
# F1_USERNAME=
# F1_PASSWORD=
